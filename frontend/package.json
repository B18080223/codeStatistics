{
  "name": "code-statistics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "electron:build-main": "node scripts/build-electron.mjs",
    "electron:dev": "npm run electron:build-main && concurrently \"vite\" \"wait-on http://localhost:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron electron-dist/main.cjs\"",
    "electron:build": "npm run build && npm run electron:build-main && electron-builder"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.5",
    "qiankun": "^2.10.16",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "happy-dom": "^20.8.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0-beta.13",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.5",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  },
  "build": {
    "appId": "com.example.codestatistics",
    "productName": "Code Statistics",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/target/backend-1.0.0.jar",
        "to": "backend/backend-1.0.0.jar"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
